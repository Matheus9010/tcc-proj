    <script>
        // ============================================
        // NAVEGAÇÃO ENTRE SEÇÕES (Sidebar)
        // ============================================
        document.querySelectorAll('.sidebar a[data-section]').forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                const sectionId = this.dataset.section;
                mostrarSecao(sectionId);

                document.querySelectorAll('.sidebar a[data-section]').forEach(l => l.classList.remove('active'));
                this.classList.add('active');
            });
        });

        function mostrarSecao(id) {
            document.querySelectorAll('.section').forEach(s => s.classList.remove('active'));
            const target = document.getElementById(id);
            if (target) {
                target.classList.add('active');
                target.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }

        // ============================================
        // ACESSIBILIDADE - FONTE
        // ============================================
        let fontSize = 16;

        function aumentarFonte() {
            fontSize = Math.min(fontSize + 2, 24);
            document.querySelector('.main-content').style.fontSize = fontSize + 'px';
            salvarConfig('fontSize', fontSize);
        }

        function diminuirFonte() {
            fontSize = Math.max(fontSize - 2, 12);
            document.querySelector('.main-content').style.fontSize = fontSize + 'px';
            salvarConfig('fontSize', fontSize);
        }

        // ============================================
        // CONFIGURAÇÕES (TOGGLES)
        // ============================================
        function toggleDarkMode() {
            const toggle = document.getElementById('toggleDark');
            toggle.classList.toggle('active');
            const isActive = toggle.classList.contains('active');
            toggle.setAttribute('aria-checked', isActive);

            const main = document.querySelector('.main-content');
            main.style.backgroundColor = isActive ? '#1a1a2e' : '#f0f4ff';
            main.style.color = isActive ? '#eee' : '#1a1a2e';
            salvarConfig('darkMode', isActive);
        }

        function toggleContrast() {
            const toggle = document.getElementById('toggleContrast');
            toggle.classList.toggle('active');
            const isActive = toggle.classList.contains('active');
            toggle.setAttribute('aria-checked', isActive);

            document.body.classList.toggle('high-contrast', isActive);
            salvarConfig('contrast', isActive);
            return false;
        }

        // ============================================
        // NARRADOR (SPEECH SYNTHESIS) - CORRIGIDO
        // ============================================
        let speechActive = false;
        let speechElements = [];

        function toggleSpeech() {
            const toggle = document.getElementById('toggleSpeech');
            toggle.classList.toggle('active');
            speechActive = toggle.classList.contains('active');
            toggle.setAttribute('aria-checked', speechActive);

            // Atualiza o texto do link na barra de acessibilidade
            const speechStatus = document.getElementById('speechStatus');
            if (speechStatus) {
                speechStatus.textContent = speechActive ? 'Narrador ON' : 'Narrador';
            }

            // Cancela qualquer narração em andamento
            if (window.speechSynthesis) {
                window.speechSynthesis.cancel();
            }

            if (speechActive) {
                // Remove listeners antigos para evitar duplicação
                removerListenersSpeech();

                // Seleciona todos os textos que serão narrados
                const textos = document.querySelectorAll(
                    '.main-content p, .main-content li, .main-content h2, .main-content h3, .main-content .card p, .main-content .card h3'
                );

                textos.forEach(el => {
                    // Pula elementos vazios ou muito curtos
                    if (!el.textContent || el.textContent.trim().length < 5) return;

                    const handler = function(e) {
                        // Evita narração duplicada
                        if (window.speechSynthesis.speaking) {
                            window.speechSynthesis.cancel();
                        }

                        const texto = this.textContent.trim();
                        if (texto && texto.length > 3) {
                            const utterance = new SpeechSynthesisUtterance(texto);
                            utterance.lang = 'pt-BR';
                            utterance.rate = 0.85;
                            utterance.pitch = 1;
                            utterance.volume = 1;

                            // Seleciona uma voz feminina em português se disponível
                            const voices = window.speechSynthesis.getVoices();
                            const ptVoice = voices.find(v => v.lang.includes('pt'));
                            if (ptVoice) {
                                utterance.voice = ptVoice;
                            }

                            window.speechSynthesis.speak(utterance);
                        }
                    };

                    el.addEventListener('mouseenter', handler);
                    el.addEventListener('focus', handler);

                    // Armazena referência para remover depois
                    speechElements.push({ element: el, handler: handler });
                });

                alert('🔊 Narração ativada! Passe o mouse ou foque nos textos para ouvir.');

                // Carrega vozes disponíveis
                if (window.speechSynthesis) {
                    window.speechSynthesis.getVoices();
                    window.speechSynthesis.onvoiceschanged = () => {
                        window.speechSynthesis.getVoices();
                    };
                }
            } else {
                removerListenersSpeech();
                alert('🔇 Narração desativada.');
            }

            salvarConfig('speech', speechActive);
            return false;
        }

        function removerListenersSpeech() {
            speechElements.forEach(({ element, handler }) => {
                element.removeEventListener('mouseenter', handler);
                element.removeEventListener('focus', handler);
            });
            speechElements = [];

            // Cancela qualquer narração em andamento
            if (window.speechSynthesis) {
                window.speechSynthesis.cancel();
            }
        }

        // ============================================
        // NOTIFICAÇÕES
        // ============================================
        function toggleNotifications() {
            const toggle = document.getElementById('toggleNotifications');
            toggle.classList.toggle('active');
            const isActive = toggle.classList.contains('active');
            toggle.setAttribute('aria-checked', isActive);
            salvarConfig('notifications', isActive);
        }

        // ============================================
        // SALVAR CONFIGURAÇÕES (localStorage)
        // ============================================
        function salvarConfig(chave, valor) {
            let config = JSON.parse(localStorage.getItem('configAero') || '{}');
            config[chave] = valor;
            localStorage.setItem('configAero', JSON.stringify(config));
        }

        function carregarConfig() {
            const config = JSON.parse(localStorage.getItem('configAero') || '{}');
            const main = document.querySelector('.main-content');

            if (config.fontSize) {
                fontSize = config.fontSize;
                main.style.fontSize = fontSize + 'px';
            }

            if (config.darkMode) {
                document.getElementById('toggleDark').classList.add('active');
                document.getElementById('toggleDark').setAttribute('aria-checked', 'true');
                main.style.backgroundColor = '#1a1a2e';
                main.style.color = '#eee';
            }

            if (config.contrast) {
                document.getElementById('toggleContrast').classList.add('active');
                document.getElementById('toggleContrast').setAttribute('aria-checked', 'true');
                document.body.classList.add('high-contrast');
            }

            if (config.notifications) {
                document.getElementById('toggleNotifications').classList.add('active');
                document.getElementById('toggleNotifications').setAttribute('aria-checked', 'true');
            }

            if (config.speech) {
                document.getElementById('toggleSpeech').classList.add('active');
                document.getElementById('toggleSpeech').setAttribute('aria-checked', 'true');
                // Ativa a narração automaticamente se estava salva
                setTimeout(() => {
                    speechActive = true;
                    const speechStatus = document.getElementById('speechStatus');
                    if (speechStatus) {
                        speechStatus.textContent = 'Narrador ON';
                    }
                    // Aplica os listeners sem mostrar o alerta novamente
                    aplicarSpeechListeners();
                }, 500);
            }
        }

        // Função auxiliar para aplicar listeners do narrador sem alerta
        function aplicarSpeechListeners() {
            if (window.speechSynthesis) {
                window.speechSynthesis.cancel();
            }

            const textos = document.querySelectorAll(
                '.main-content p, .main-content li, .main-content h2, .main-content h3, .main-content .card p, .main-content .card h3'
            );

            textos.forEach(el => {
                if (!el.textContent || el.textContent.trim().length < 5) return;

                const handler = function(e) {
                    if (window.speechSynthesis.speaking) {
                        window.speechSynthesis.cancel();
                    }
                    const texto = this.textContent.trim();
                    if (texto && texto.length > 3) {
                        const utterance = new SpeechSynthesisUtterance(texto);
                        utterance.lang = 'pt-BR';
                        utterance.rate = 0.85;
                        utterance.pitch = 1;
                        utterance.volume = 1;

                        const voices = window.speechSynthesis.getVoices();
                        const ptVoice = voices.find(v => v.lang.includes('pt'));
                        if (ptVoice) {
                            utterance.voice = ptVoice;
                        }

                        window.speechSynthesis.speak(utterance);
                    }
                };

                el.addEventListener('mouseenter', handler);
                el.addEventListener('focus', handler);
                speechElements.push({ element: el, handler: handler });
            });
        }

        // ============================================
        // SISTEMA DE LOGIN (Sidebar + Login)
        // ============================================
        let usuarioLogado = null;

        function atualizarStatusLogin() {
            const status = document.getElementById('statusTexto');
            const btnLogin = document.getElementById('btnLogin');
            const btnLogout = document.getElementById('btnLogout');
            const emailInput = document.getElementById('emailLogin');
            const senhaInput = document.getElementById('senhaLogin');

            const userStatus = document.getElementById('userStatus');
            const userInitials = document.getElementById('userInitials');
            const userName = document.getElementById('userName');
            const logoutBtn = document.getElementById('logoutBtn');

            if (usuarioLogado) {
                status.innerHTML = `✅ Logado como <span class="user-name">${usuarioLogado}</span>`;
                btnLogin.style.display = 'none';
                btnLogout.style.display = 'block';
                emailInput.disabled = true;
                senhaInput.disabled = true;

                userStatus.style.display = 'flex';
                userInitials.textContent = usuarioLogado.charAt(0).toUpperCase();
                userName.textContent = usuarioLogado;
                logoutBtn.style.display = 'block';
            } else {
                status.innerHTML = '🔓 Você não está logado';
                btnLogin.style.display = 'block';
                btnLogout.style.display = 'none';
                emailInput.disabled = false;
                senhaInput.disabled = false;

                userStatus.style.display = 'none';
            }
        }

        // Login
        document.getElementById('formLogin').addEventListener('submit', function(e) {
            e.preventDefault();
            const email = document.getElementById('emailLogin').value.trim();
            const senha = document.getElementById('senhaLogin').value;

            if (email && senha.length >= 6) {
                usuarioLogado = email.split('@')[0];
                localStorage.setItem('usuarioAero', JSON.stringify({ email, nome: usuarioLogado }));
                atualizarStatusLogin();
                mostrarFeedback('feedbackCadastro', `✅ Bem-vindo(a), ${usuarioLogado}! Login realizado com sucesso.`,
                    'success');
            } else {
                alert('❌ Por favor, preencha e-mail e senha (mínimo 6 caracteres).');
            }
        });

        // Logout
        document.getElementById('btnLogout').addEventListener('click', function() {
            if (confirm('Deseja realmente sair da sua conta?')) {
                usuarioLogado = null;
                localStorage.removeItem('usuarioAero');
                atualizarStatusLogin();
                mostrarFeedback('feedbackCadastro', '👋 Você saiu da sua conta.', '');
            }
        });

        document.getElementById('logoutBtn').addEventListener('click', function() {
            if (confirm('Deseja realmente sair da sua conta?')) {
                usuarioLogado = null;
                localStorage.removeItem('usuarioAero');
                atualizarStatusLogin();
                mostrarFeedback('feedbackCadastro', '👋 Você saiu da sua conta.', '');
            }
        });

        // ============================================
        // FEEDBACK
        // ============================================
        function mostrarFeedback(id, mensagem, tipo) {
            const el = document.getElementById(id);
            if (!el) return;
            el.textContent = mensagem;
            el.className = 'feedback';
            if (tipo) {
                el.classList.add(tipo);
            }
            el.style.display = 'block';
            setTimeout(() => {
                el.style.display = 'none';
            }, 5000);
        }

        // ============================================
        // FORMULÁRIO DE CADASTRO
        // ============================================
        document.getElementById('formCadastro').addEventListener('submit', function(e) {
            e.preventDefault();

            const nome = document.getElementById('nomeCadastro').value.trim();
            const email = document.getElementById('emailCadastro').value.trim();
            const dataNasc = document.getElementById('dataNascimento').value;
            const senha = document.getElementById('senhaCadastro').value;
            const confirmar = document.getElementById('confirmarSenha').value;

            if (!nome || !email || !dataNasc || !senha || !confirmar) {
                mostrarFeedback('feedbackCadastro', '⚠️ Preencha todos os campos obrigatórios.', 'error');
                return;
            }

            if (senha !== confirmar) {
                mostrarFeedback('feedbackCadastro', '❌ As senhas não coincidem.', 'error');
                return;
            }

            if (senha.length < 6) {
                mostrarFeedback('feedbackCadastro', '❌ A senha deve ter no mínimo 6 caracteres.', 'error');
                return;
            }

            const usuarios = JSON.parse(localStorage.getItem('usuariosAero') || '[]');
            if (usuarios.find(u => u.email === email)) {
                mostrarFeedback('feedbackCadastro', '❌ Este e-mail já está cadastrado.', 'error');
                return;
            }

            usuarios.push({ nome, email, senha, dataNasc, data: new Date().toISOString() });
            localStorage.setItem('usuariosAero', JSON.stringify(usuarios));

            mostrarFeedback('feedbackCadastro', `✅ Cadastro realizado com sucesso! Bem-vindo(a), ${nome}!`, 'success');

            usuarioLogado = nome;
            localStorage.setItem('usuarioAero', JSON.stringify({ email, nome }));
            atualizarStatusLogin();

            this.reset();
        });

        // ============================================
        // FORMULÁRIO DE CONTATO
        // ============================================
        document.getElementById('formContato').addEventListener('submit', function(e) {
            e.preventDefault();

            const nome = document.getElementById('nomeContato').value.trim();
            const email = document.getElementById('emailContato').value.trim();
            const mensagem = document.getElementById('mensagemContato').value.trim();

            if (!nome || !email || !mensagem) {
                mostrarFeedback('feedbackContato', '⚠️ Preencha todos os campos obrigatórios.', 'error');
                return;
            }

            mostrarFeedback('feedbackContato', `✅ Mensagem enviada com sucesso! Entraremos em contato em breve, ${nome}.`,
                'success');
            this.reset();
        });

        // ============================================
        // CARREGAR CONFIGURAÇÕES E STATUS AO INICIAR
        // ============================================
        document.addEventListener('DOMContentLoaded', function() {
            // Carrega vozes do speech synthesis
            if (window.speechSynthesis) {
                window.speechSynthesis.getVoices();
                window.speechSynthesis.onvoiceschanged = () => {
                    window.speechSynthesis.getVoices();
                };
            }

            carregarConfig();

            const usuarioSalvo = localStorage.getItem('usuarioAero');
            if (usuarioSalvo) {
                try {
                    const data = JSON.parse(usuarioSalvo);
                    if (data && data.email) {
                        usuarioLogado = data.nome || data.email.split('@')[0];
                    }
                } catch (e) {
                    usuarioLogado = null;
                }
            }
            atualizarStatusLogin();

            // Suporte para teclado nos toggles
            document.querySelectorAll('.toggle').forEach(toggle => {
                toggle.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter' || e.key === ' ') {
                        e.preventDefault();
                        this.click();
                    }
                });
            });
        });

        // ============================================
        // FECHAR FEEDBACKS COM CLICK
        // ============================================
        document.querySelectorAll('.feedback').forEach(el => {
            el.addEventListener('click', function() {
                this.style.display = 'none';
            });
        });
    </script>
</body>
</html>
